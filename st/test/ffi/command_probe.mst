"command_probe.mst — commands and menus (DolphinDart DD10).

 A shell with a real Win32 menu bar whose items are driven by Dolphin's own
 command machinery: `UI.CommandQuery` decides enablement, `queryCommand:` is
 the hook Dolphin calls to ask, and the answer is pushed at Windows through
 `WinMenu`.

 The menu is REAL — CreateMenu/InsertMenuItem/SetMenu — so a click arrives as
 a genuine WM_COMMAND at the owning window, and finds it through DD10's
 per-window routing."
UiWindow subclass: CommandProbe [
    | menu fileMenu model performed lastCommand |

    CommandProbe class >> idDouble [ ^7001 ]
    CommandProbe class >> idReset [ ^7002 ]
    CommandProbe class >> idQuit [ ^7003 ]

    initWindow [ super initWindow. performed := 0 ]
    model [ ^model ]
    menu [ ^menu ]
    performed [ ^performed ]
    lastCommand [ ^lastCommand ]

    build [
        model := ValueHolder with: 5.
        fileMenu := WinMenu popup.
        fileMenu add: '&Double' id: CommandProbe idDouble.
        fileMenu add: '&Reset' id: CommandProbe idReset.
        fileMenu add: '&Quit' id: CommandProbe idQuit.
        menu := WinMenu bar.
        menu addSubmenu: fileMenu text: '&File'.
        menu attachTo: hwnd.
        self updateMenu.
        ^self
    ]

    "── the commands ────────────────────────────────────────────────────"
    commandIds [
        ^Array
            with: CommandProbe idDouble
            with: CommandProbe idReset
            with: CommandProbe idQuit
    ]

    selectorFor: anId [
        anId = CommandProbe idDouble ifTrue: [ ^#double ].
        anId = CommandProbe idReset ifTrue: [ ^#reset ].
        anId = CommandProbe idQuit ifTrue: [ ^#quitApp ].
        ^nil
    ]

    "Dolphin's own hook. A view answers a CommandQuery saying whether the
     command applies right now; the shell then pushes that at the menu.

     `#reset` is deliberately conditional — it is only meaningful when the
     value has moved off its starting point, which is what makes the
     enable/disable observable rather than constant."
    queryCommand: aCommandQuery [
        | sel |
        sel := aCommandQuery commandSymbol.
        sel == #reset
            ifTrue: [ model value = 5
                        ifTrue: [ aCommandQuery beDisabled ]
                        ifFalse: [ aCommandQuery beEnabled ] ]
            ifFalse: [ aCommandQuery beEnabled ].
        ^true
    ]

    "Ask Dolphin's machinery about every command, then tell Windows."
    updateMenu [
        self commandIds do: [ :id |
            | q |
            q := CommandQuery commandDescription:
                    (CommandDescription command: (self selectorFor: id))
                 source: self.
            self queryCommand: q.
            fileMenu enable: id set: q isEnabled ].
        ^self
    ]

    "── WM_COMMAND, arriving from the real menu ─────────────────────────
     Refuses a DISABLED command rather than performing it. Windows greys the
     item so a user cannot click it, but an accelerator or a posted message
     can still deliver the id — Dolphin checks, so this checks."
    onCommand: anId [
        | sel q |
        sel := self selectorFor: anId.
        sel isNil ifTrue: [ ^0 ].
        q := CommandQuery commandDescription:
                (CommandDescription command: sel) source: self.
        self queryCommand: q.
        q isEnabled ifFalse: [ ^0 ].
        lastCommand := sel.
        performed := performed + 1.
        self perform: sel.
        self updateMenu.
        ^0
    ]

    "Read an item's enablement back out of the real menu — the gate asserts
     through this so the answer comes from Windows, not from us."
    menuFileEnabled: anId [ ^fileMenu isEnabled: anId ]

    double [ ^model value: model value * 2 ]
    reset [ ^model value: 5 ]
    quitApp [ ^#quit ]
]
