"shell_probe.mst — the DD9 acceptance shell.

 A code-built window with three real Win32 child controls, laid out by
 DOLPHIN'S OWN `BorderLayout` running unmodified on this VM, relaid on every
 real WM_SIZE through Dolphin's message map.

 What is Dolphin's here: the layout algorithm (`UI.BorderLayout`), the batching
 (`UI.LayoutContext`, `UI.LayoutPlacement`), the geometry (`Graphics.Rectangle`,
 `Point`), and the dispatch (`View class >> buildMessageMap`). What is ours: the
 window and its controls, and `WinView`, the adapter that answers Dolphin's
 view protocol from Win32 calls.

 The arrangement is Dolphin's north/center/south: a label across the top, two
 buttons docked at the bottom, and a centre panel taking the rest."
UiWindow subclass: ShellProbe [
    | container layout label okButton cancelButton relayouts |

    ShellProbe class >> labelId [ ^3001 ]
    ShellProbe class >> okId [ ^3002 ]
    ShellProbe class >> cancelId [ ^3003 ]
    ShellProbe class >> edgeHeight [ ^28 ]

    initWindow [ super initWindow. relayouts := 0 ]
    relayouts [ ^relayouts ]
    container [ ^container ]
    layout [ ^layout ]
    label [ ^label ]
    okButton [ ^okButton ]
    cancelButton [ ^cancelButton ]

    "Build the controls and wire Dolphin's BorderLayout over them."
    buildControls [
        container := WinView onHandle: hwnd.
        label := WinView
            onHandle: (Win32 mvpCreateButton: hwnd id: ShellProbe labelId)
            parent: container.
        okButton := WinView
            onHandle: (Win32 mvpCreateButton: hwnd id: ShellProbe okId)
            parent: container.
        cancelButton := WinView
            onHandle: (Win32 mvpCreateButton: hwnd id: ShellProbe cancelId)
            parent: container.
        "The two docked edges declare their wanted height; the centre takes
         whatever is left, so it declares nothing."
        label preferredExtent: 0 @ ShellProbe edgeHeight.
        okButton preferredExtent: 0 @ ShellProbe edgeHeight.
        layout := BorderLayout new.
        layout north: label.
        layout south: okButton.
        layout center: cancelButton.
        ^self relayout
    ]

    "One layout pass, exactly as Dolphin runs it: build a context, let
     BorderLayout fill it, apply the batch."
    relayout [
        | ctx |
        relayouts := relayouts + 1.
        ctx := LayoutContext forContainer: container.
        layout layoutContainer: container context: ctx.
        ctx apply.
        ^relayouts
    ]

    "WM_SIZE, arriving through Dolphin's own message map. Answering nil would
     decline it; 0 is what a handled WM_SIZE returns."
    wmSize: msg wParam: wp lParam: lp [ self relayout. ^0 ]

    "Focus/tab. SetFocus is the substrate's; which control HAS focus is the
     assertion the gate makes."
    focusOk [ ^okButton setFocus. ]
    focusCancel [ ^cancelButton setFocus. ]

    resizeTo: w by: h [
        ^User32
            setWindowPos: hwnd
            hWndInsertAfter: 0
            x: 0 y: 0 cx: w cy: h
            uFlags: 16r16          "SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE"
    ]
]
