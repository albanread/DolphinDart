"text_probe.mst — the MVP triad over a real EDIT control (DolphinDart DD10).

 The triad's claim, made concrete: **two presenters over ONE model**. Edit
 either field and both it and the model move; the other field follows.

 Everything load-bearing here is Dolphin's. The model is `UI.ValueHolder`, the
 conversion is `UI.NumberToText`, the notification is Dolphin's event system,
 and the bad-input signal is `InvalidFormat`. Ours is `WinTextEdit` — a real
 Win32 EDIT control created through the generated `createWindowEx:` prim.

 THE BEEP-AND-REVERT PATH is what DD4 gates this sprint for. A field whose
 text will not convert must not write nil into the model and must not keep the
 bad text: it signals `InvalidFormat`, the presenter beeps, and the field
 reverts to the model's current value rendered back through the converter."
Object subclass: TextField [
    | edit model converter beeps reverts updating |

    TextField class >> on: aParent id: anId model: aValueModel [
        ^self basicNew setEdit: (WinTextEdit in: aParent id: anId)
                       model: aValueModel
    ]

    setEdit: aWinTextEdit model: aValueModel [
        edit := aWinTextEdit.
        converter := NumberToText new.
        beeps := 0. reverts := 0. updating := false.
        model := aValueModel.
        "Follow the model: any change, from anywhere, redraws this field."
        model when: #valueChanged send: #refresh to: self.
        self refresh
    ]

    edit [ ^edit ]
    model [ ^model ]
    beeps [ ^beeps ]
    reverts [ ^reverts ]
    text [ ^edit text ]
    type: aString [ ^edit text: aString ]

    "Model -> view. Guarded because `flush` writes the model, which notifies,
     which lands back here; without the guard a keystroke would overwrite the
     text the user is still typing."
    refresh [
        updating ifTrue: [ ^self ].
        updating := true.
        [ edit text: (converter leftToRight: model value) ]
            ensure: [ updating := false ].
        ^self
    ]

    "View -> model. This is what a real presenter runs on kill-focus or on the
     EN_CHANGE notification; the gate drives it directly so the assertion is
     about the CONVERSION path, not about Windows' notification timing."
    flush [
        | v |
        v := [ converter rightToLeft: edit text ]
            on: InvalidFormat
            do: [ :e | beeps := beeps + 1. self revert. ^nil ].
        model value: v.
        ^v
    ]

    "Beep-and-revert: put the MODEL's value back, rendered through the same
     converter — so the field always shows something the model actually holds."
    revert [
        reverts := reverts + 1.
        updating := true.
        [ edit text: (converter leftToRight: model value) ]
            ensure: [ updating := false ].
        ^self
    ]
]

"The shell that owns two fields over one model."
UiWindow subclass: TextProbe [
    | left right model |

    TextProbe class >> leftId [ ^6001 ]
    TextProbe class >> rightId [ ^6002 ]

    model [ ^model ]
    left [ ^left ]
    right [ ^right ]

    build [
        | container |
        container := WinView onHandle: hwnd.
        model := ValueHolder with: 100.
        left := TextField on: container id: TextProbe leftId model: model.
        right := TextField on: container id: TextProbe rightId model: model.
        ^self
    ]
]
