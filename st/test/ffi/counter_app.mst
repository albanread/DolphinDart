"counter_app.mst — a SUBSTRATE DEMONSTRATION (demoted 2026-08-16).

 NOT the DD10 acceptance app. Its presenter and view layer are hand-written
 (`TextField`, `WinTextEdit`, `WinMenu`) — scaffolding per the course
 correction in docs/sprints/dd10_NOTES.md — so it proves the SUBSTRATE
 carries a whole application, and nothing more. The real acceptance app is
 built from Dolphin's own Shell/TextPresenter/Menu once `UI.View` owns
 windows.

 Everything DD10 built, in one application:

   * a model (`UI.ValueHolder`) edited through TWO fields, each a real Win32
     EDIT control with a `UI.NumberToText` converter;
   * a real menu bar whose enablement is decided by `UI.CommandQuery` through
     `queryCommand:`, with a Ctrl+D accelerator on one command;
   * a long command that ships work to an isolate and updates the model from
     the posted continuation — never from the worker;
   * bad input that signals `InvalidFormat`, beeps, and reverts.

 It is a hand-written doit, not translated code: an APP is what the port is
 for, and this is the first one. Its parts are Dolphin's."
UiWindow subclass: CounterApp [
    | container fieldA fieldB model menu fileMenu accel
      commandsRun lastCommand busy workerResults |

    CounterApp class >> idA [ ^8001 ]
    CounterApp class >> idB [ ^8002 ]
    CounterApp class >> cmdDouble [ ^8101 ]
    CounterApp class >> cmdReset [ ^8102 ]
    CounterApp class >> cmdCount [ ^8103 ]
    "'D' — the accelerator is Ctrl+D on Double."
    CounterApp class >> vkD [ ^68 ]

    initWindow [
        super initWindow. commandsRun := 0. busy := false. workerResults := 0
    ]

    model [ ^model ]
    fieldA [ ^fieldA ]
    fieldB [ ^fieldB ]
    menu [ ^menu ]
    commandsRun [ ^commandsRun ]
    lastCommand [ ^lastCommand ]
    busy [ ^busy ]
    workerResults [ ^workerResults ]

    build [
        model := ValueHolder with: 3.
        container := WinView onHandle: hwnd.
        fieldA := TextField on: container id: CounterApp idA model: model.
        fieldB := TextField on: container id: CounterApp idB model: model.
        fileMenu := WinMenu popup.
        fileMenu add: '&Double' id: CounterApp cmdDouble.
        fileMenu add: '&Reset' id: CounterApp cmdReset.
        fileMenu add: '&Count (slow)' id: CounterApp cmdCount.
        menu := WinMenu bar.
        menu addSubmenu: fileMenu text: '&Edit'.
        menu attachTo: hwnd.
        accel := WinAccelerators ctrlKeys:
            (Array with: (Array with: CounterApp vkD with: CounterApp cmdDouble)).
        accel installFor: hwnd.
        "Enablement follows the MODEL, not just commands: an edit through a
         field must grey/ungrey Reset too. Dolphin refreshes at menu-popup
         time; a model subscription is this app's equivalent."
        model when: #valueChanged send: #updateCommands to: self.
        self updateCommands.
        ^self
    ]

    accel [ ^accel ]

    "── commands ────────────────────────────────────────────────────────"
    commandIds [
        ^Array
            with: CounterApp cmdDouble
            with: CounterApp cmdReset
            with: CounterApp cmdCount
    ]
    selectorFor: anId [
        anId = CounterApp cmdDouble ifTrue: [ ^#doDouble ].
        anId = CounterApp cmdReset ifTrue: [ ^#doReset ].
        anId = CounterApp cmdCount ifTrue: [ ^#doCount ].
        ^nil
    ]

    "Dolphin's hook. Two conditions, both observable: Reset only matters once
     the value has moved, and NOTHING is available while a long command is in
     flight — which is how a real app stops a second click piling work on the
     first."
    queryCommand: aQuery [
        | sel |
        sel := aQuery commandSymbol.
        busy
            ifTrue: [ aQuery beDisabled ]
            ifFalse: [
                (sel == #doReset and: [ model value = 3 ])
                    ifTrue: [ aQuery beDisabled ]
                    ifFalse: [ aQuery beEnabled ] ].
        ^true
    ]

    updateCommands [
        self commandIds do: [ :id |
            | q |
            q := CommandQuery commandDescription:
                    (CommandDescription command: (self selectorFor: id))
                 source: self.
            self queryCommand: q.
            fileMenu enable: id set: q isEnabled ].
        ^self
    ]

    isEnabled: anId [ ^fileMenu isEnabled: anId ]

    "WM_COMMAND — from a menu click OR from the accelerator, which Windows
     turns into the same message. Refuses a disabled command."
    onCommand: anId [
        | sel q |
        sel := self selectorFor: anId.
        sel isNil ifTrue: [ ^0 ].
        q := CommandQuery commandDescription:
                (CommandDescription command: sel) source: self.
        self queryCommand: q.
        q isEnabled ifFalse: [ ^0 ].
        lastCommand := sel.
        commandsRun := commandsRun + 1.
        self perform: sel.
        self updateCommands.
        ^0
    ]

    "── driving the accelerator from a test ─────────────────────────────
     A real Ctrl chord needs the Ctrl key actually DOWN when the pump
     translates the keystroke, which `SendMessage(WM_KEYDOWN)` alone does not
     arrange — GetKeyState reads the thread's key state, not the message.
     SetKeyboardState puts Ctrl down for real, then the keystroke is POSTED
     (not sent) so it goes through the queue where TranslateAcceleratorW can
     see it. Posting is the point: an accelerator is a PUMP behaviour."
    pressCtrlD [
        | state |
        state := ExternalMemory new: 256.
        User32 getKeyboardState: state address.
        "VK_CONTROL is 16r11; the high bit means down."
        state byteAt: 16r11 + 1 put: 16r80.
        User32 setKeyboardState: state address.
        User32 postMessage: hwnd msg: 16r100 wParam: 68 lParam: 0.
        "SetKeyboardState copied the array, so the block can go."
        state free.
        ^self
    ]
    "Give this window the focus, so a posted keystroke belongs to it."
    focusSelf [ ^User32 setFocus: hwnd ]

    doDouble [ ^model value: model value * 2 ]
    doReset [ ^model value: 3 ]

    "THE LONG COMMAND. Ships work to an isolate and returns at once; the
     continuation updates the MODEL, on the UI thread, out of the posted-action
     queue. Nothing here touches a view — the fields follow because the model
     moved, exactly as they do for a keystroke."
    doCount [
        busy := true.
        ^Worker do: #slowSum with: 40000000 then: [ :r |
            busy := false.
            workerResults := workerResults + 1.
            model value: (r \\ 1000).
            self updateCommands ]
    ]
]
