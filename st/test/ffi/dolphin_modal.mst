"dolphin_modal.mst — DD12's goal-gate core: a REAL modal dialog.

 A `DialogView` owned by a shell, carrying a TextEdit and OK/Cancel
 `PushButton`s over a BUFFERED model — Dolphin's own classes, its own
 `showModal`, its own `ValueBuffer` semantics.

 WHAT MAKES THIS THE GOAL GATE AND NOT A WINDOW WITH BUTTONS:

   * The owner is DISABLED while the dialog is up and re-enabled after —
     asked of Windows (`IsWindowEnabled`), not of the image.
   * `showModal` BLOCKS: the statement after it does not run until the dialog
     closes. A gate proves that by posting a deferred action BEFORE entering,
     which the nested pump drains from INSIDE the modal loop — so the
     dismissal happens while the caller is genuinely blocked.
   * OK APPLIES the buffered edit to the subject; Cancel leaves the subject
     untouched. That is the difference between a dialog and a form.
   * Two STACKED modals unwind innermost-first, which is the only order a
     single-threaded nested pump can unwind in.

 NOT DOLPHIN'S VIEW RESOURCES. Dolphin builds this view from an STB resource
 in its image; per the standing rule this builds the same controls
 programmatically. The BEHAVIOUR is Dolphin's; the construction is ours."
DialogView subclass: ValuePromptView [
    | edit okButton cancelButton buffer |

    edit [ ^edit ]
    okButton [ ^okButton ]
    cancelButton [ ^cancelButton ]
    buffer [ ^buffer ]

    "The BUFFER is the whole point. `ValueBuffer subject:` wraps the subject
     model; edits go to the buffer, and only `apply` writes them through."
    onSubject: aValueModel [
        "`ValueBuffer class >> new` is `shouldNotImplement` — Dolphin insists
         a buffer is created ON a subject, which is the whole contract."
        buffer := ValueBuffer subject: aValueModel.
        ^buffer
    ]

    build [
        edit := TextEdit new.
        edit parentView: self.
        edit preferredExtent: 260 @ 26.
        edit usePreferredExtent: true.
        self addSubView: edit.

        okButton := PushButton new.
        okButton parentView: self.
        okButton preferredExtent: 90 @ 28.
        okButton usePreferredExtent: true.
        self addSubView: okButton.
        okButton text: '&OK'.

        cancelButton := PushButton new.
        cancelButton parentView: self.
        cancelButton preferredExtent: 90 @ 28.
        cancelButton usePreferredExtent: true.
        self addSubView: cancelButton.
        cancelButton text: '&Cancel'.

        self layoutManager: (BorderLayout new
            north: edit;
            west: cancelButton;
            east: okButton;
            yourself).
        ^self
    ]

    "Seed the editor from the buffer, which starts at the subject's value."
    refreshFromBuffer [
        edit text: (buffer value ifNil: [ '' ]) displayString.
        ^edit text
    ]

    "OK: take what the user typed, put it in the BUFFER, apply the buffer to
     the subject, then close. Cancel: close without applying — the buffer is
     discarded with the dialog and the subject never hears about the edit."
    ok [
        buffer setValue: edit text.
        buffer apply.
        self answer: edit text.
        self destroy.
        ^self answer
    ]
    cancel [
        self answer: nil.
        self destroy.
        ^nil
    ]
]

"The owner. Opens dialogs, and — more importantly — RECORDS THE ORDER events
 actually happened in, because that order is the whole difference between a
 modal and a window with buttons on it. Every driver here posts its dismissal
 with `UiSession postAction:` BEFORE entering `showModal`; the queue is drained
 by `pump`, and the only pump running at that moment is the NESTED one inside
 the modal loop. So a dismissal that happens at all is proof the nested loop
 ran, and a dismissal that happens BEFORE `showModal` returns is proof the
 caller was genuinely blocked."
ShellView subclass: ModalOwnerShell [
    | subject lastAnswer inner trace ownerEnabledWhileModal |

    subject [ ^subject ]
    lastAnswer [ ^lastAnswer ]
    inner [ ^inner ]
    trace [ ^trace ifNil: [ trace := OrderedCollection new ] ]
    traceString [ ^(self trace inject: '' into: [ :a :b | a , b , ' ' ]) trimBlanks ]
    note: aString [ ^self trace add: aString ]
    resetTrace [ trace := OrderedCollection new. ^self ]

    "What WINDOWS said about the owner while the dialog was up — sampled from
     inside the nested loop, which is the only moment the answer means
     anything. Sampling after `showModal` returns would always answer true,
     because its ensure block has re-enabled the owner by then."
    ownerEnabledWhileModal [ ^ownerEnabledWhileModal ]

    ModalOwnerShell class >> routeDolphinMessages [ ^UiSession routeMessagesFrom: View ]

    build [
        subject := ValueHolder new.
        subject value: 'original'.
        ^self
    ]

    "Build a modal owned by aView, ready to show. Owner AND parent: a window
     with a parent handle but no WS_CHILD is an OWNED POPUP, which is the
     relationship a modal needs — Windows keeps it above its owner and routes
     the owner's disablement correctly."
    newPromptOwnedBy: aView [
        | dlg |
        dlg := ValuePromptView new.
        dlg owner: aView.
        dlg parentView: aView.
        dlg create.
        dlg build.
        dlg onSubject: subject.
        dlg refreshFromBuffer.
        inner := dlg.
        ^dlg
    ]
    newPrompt [ ^self newPromptOwnedBy: self ]

    "Show it modally. BLOCKS in the nested pump until the dialog closes."
    promptModally [
        lastAnswer := inner showModal.
        ^lastAnswer
    ]

    "── the drivers ─────────────────────────────────────────────────────
     `dismiss` runs from inside the modal loop. It samples the owner's
     enablement first (while it still means something), types into the edit
     exactly as a user would, then presses the button."
    promptTyping: aString then: aSymbol [
        | dlg |
        self resetTrace.
        dlg := self newPrompt.
        UiSession postAction: [
            ownerEnabledWhileModal := User32 isWindowEnabled: self handle.
            self note: 'dismissing'.
            dlg edit text: aString.
            dlg perform: aSymbol ].
        self note: 'entering'.
        self promptModally.
        self note: 'returned'.
        ^lastAnswer
    ]

    "OK applies the buffered edit through to the subject; Cancel does not."
    promptOk: aString [ ^self promptTyping: aString then: #ok ]
    promptCancel: aString [ ^self promptTyping: aString then: #cancel ]

    "── two STACKED modals ──────────────────────────────────────────────
     The inner dialog is owned by the OUTER dialog, which is what stacking
     means: each level disables the one below it. The unwind order is the
     assertion — a single-threaded nested pump can only unwind innermost
     first, and if it ever unwound outermost first the inner loop would be
     pumping a destroyed window."
    promptStacked [
        | outerDlg |
        self resetTrace.
        outerDlg := self newPrompt.
        UiSession postAction: [
            | innerDlg |
            innerDlg := self newPromptOwnedBy: outerDlg.
            UiSession postAction: [
                self note: 'closeB'.
                innerDlg edit text: 'B'.
                innerDlg ok ].
            self note: 'enterB'.
            innerDlg showModal.
            self note: 'returnB'.
            self note: 'closeA'.
            outerDlg edit text: 'A'.
            outerDlg ok ].
        self note: 'enterA'.
        inner := outerDlg.
        self promptModally.
        self note: 'returnA'.
        ^self traceString
    ]

    subjectValue [ ^subject value ]

    "Windows' answer, not the image's."
    ownerEnabled [ ^User32 isWindowEnabled: self handle ]
]
