"02_uisession.mst — the UI session (DolphinDart DD8).

 The image side of the DD7 wndproc door, and the class Dolphin's MVP framework
 talks to. It replaces the DD7 spike classes (`MvpDoor`, `MvpWindow`), which
 existed only to prove the door's re-entry contract.

 Responsibilities, all of them Dolphin's own (prior-art G3/V3):
   * a window REGISTRY, hwnd -> view, with a lastWindow cache;
   * message ROUTING — the door calls `UiSession wndProc:arg:` for every
     reflected message and this dispatches to the registered view;
   * DEFERRED ACTIONS — `postAction:` queues a block to run on the UI thread,
     drained by the pump rather than run inside the sending entry;
   * `onIdle` — the pump-empty hook, where Dolphin revalidates commands.

 THE CONSTRAINT THAT SHAPES THIS FILE (measured, DD7): containment is at the
 DOOR. A raise inside a door entry is contained by the WndProc, which answers a
 default and keeps pumping — it does NOT reach a handler installed outside the
 entry. So any protection a view wants must be installed INSIDE its own handler,
 which is why `dispatch:` wraps the view send here and not somewhere higher."

Object subclass: UiSession [
    <classVars: Windows LastWindow Actions IdleCount MessageCount MessageMap>

    UiSession class >> reset [
        Windows := IdentityDictionary new.
        Actions := OrderedCollection new.
        LastWindow := nil. IdleCount := 0. MessageCount := 0
    ]
    UiSession class >> windows [
        Windows isNil ifTrue: [ self reset ]. ^Windows
    ]
    UiSession class >> actions [
        Actions isNil ifTrue: [ self reset ]. ^Actions
    ]

    "── the registry ────────────────────────────────────────────────────"
    UiSession class >> register: aView for: anHwnd [
        self windows at: anHwnd put: aView.
        LastWindow := aView.
        ^aView
    ]
    UiSession class >> viewFor: anHwnd [ ^self windows at: anHwnd ifAbsent: [ nil ] ]
    UiSession class >> lastWindow [ ^LastWindow ]
    UiSession class >> deregister: anHwnd [
        | v |
        v := self viewFor: anHwnd.
        self windows removeKey: anHwnd ifAbsent: [ nil ].
        (LastWindow == v) ifTrue: [ LastWindow := nil ].
        ^v
    ]
    UiSession class >> windowCount [ ^self windows size ]

    "Registry hygiene: every window the session made must be gone after a close
     cycle. DD9's gate asserts this is empty."
    UiSession class >> purgeDeadWindows [
        | dead |
        dead := OrderedCollection new.
        self windows keysAndValuesDo: [ :h :v |
            (Win32 mvpIsWindow: h) ifFalse: [ dead add: h ] ].
        dead do: [ :h | self deregister: h ].
        ^dead size
    ]

    "── message routing ─────────────────────────────────────────────────
     The door hands us (kind, hwnd, a, b, c). Kinds 1..3 are the named
     reflections (paint/command/destroy) and use `a` alone; kind 5 is a
     REFLECTED WINDOWS MESSAGE and uses all three — (msg, wParam, lParam) —
     which is why the funnel carries the payload in three slots since DD9.

     THE HWND IS WHAT MAKES MORE THAN ONE WINDOW POSSIBLE (DD10). Every
     dispatch resolves its receiver through `viewFor:`, so a message reaches
     the view that OWNS the window it arrived at. Before this, routing went to
     `LastWindow` — whichever view registered most recently — which is
     invisible with one window and wrong with two: a shell owning an EDIT
     control needs WM_COMMAND to reach the control's owner, and stacked modal
     dialogs cannot work at all.

     `LastWindow` survives only as the fallback for an UNREGISTERED hwnd,
     which is what the DD7 spike suites present: they drive the raw door
     without registering a view. A real window is always registered, so the
     fallback never fires for one.

     ANSWERING NIL MEANS 'NOT HANDLED', and the door then calls DefWindowProcW.
     Answering 0 is a different statement: it is an ordinary LRESULT, and for
     WM_NCHITTEST it means HTNOWHERE. Collapsing the two would make the door
     swallow every message it was asked to reflect."
    UiSession class >> wndProc: kind hwnd: h a: a b: b c: c [
        | view |
        MessageCount := (MessageCount ifNil: [ 0 ]) + 1.
        view := self viewForMessage: h.
        kind = 1 ifTrue: [ ^self send: #onPaint: to: view arg: a ].
        kind = 2 ifTrue: [ ^self send: #onCommand: to: view arg: a ].
        kind = 3 ifTrue: [ ^self send: #onDestroy: to: view arg: a ].
        kind = 5 ifTrue: [
            ^self dispatchMessage: a wParam: b lParam: c to: view ].
        kind = 6 ifTrue: [ ^self bindNewWindow: h ].
        ^0
    ]

    "WM_NCCREATE — Dolphin's binding moment, and the reason
     `basicCreateWindow:` runs verbatim. We are INSIDE CreateWindowExW: the
     view being created is still sitting in the slot the creating code put it
     in (`Processor activeProcess newWindow:`, which scope rule 8 makes a
     plain variable), and this HWND is not yet known to anyone else. Bind them.

     A window created by the door's own `mvpCreateTopWindow` has nothing in
     the slot, so this is a no-op for it — which is correct: those register
     themselves through `UiWindow class >> open:by:`."
    UiSession class >> bindNewWindow: anHwnd [
        | view |
        view := Processor activeProcess newWindow.
        view isNil ifTrue: [ ^0 ].
        (self viewFor: anHwnd) isNil ifFalse: [ ^0 ].
        self register: view for: anHwnd.
        ^0
    ]

    "The registered owner of `anHwnd`, or — only when nothing is registered
     for it — the last window, which is what the raw-door spikes rely on."
    UiSession class >> viewForMessage: anHwnd [
        ^(self viewFor: anHwnd) ifNil: [ LastWindow ]
    ]

    "The older entries, kept because the DD7 spike suite drives them and those
     tortures are the door's own regression. They carry no window, so they
     resolve the same way an unregistered hwnd does."
    UiSession class >> wndProc: kind a: a b: b c: c [
        ^self wndProc: kind hwnd: 0 a: a b: b c: c
    ]
    UiSession class >> wndProc: kind arg: arg [
        ^self wndProc: kind hwnd: 0 a: arg b: 0 c: 0
    ]

    "A reflected Windows message.

     With a Dolphin MESSAGE MAP installed the selector comes from the map —
     `wmPaint:wParam:lParam:` and its 90-odd siblings — which is Dolphin's own
     dispatch shape. Without one, a view may offer the flat
     `onMessage:wParam:lParam:` hook instead; the DD7/DD9 probes use that, and
     it keeps the door testable without dragging the whole View wave in.

     Either way the view answers nil for anything it does not handle, and that
     nil rides all the way back out to DefWindowProcW."
    UiSession class >> dispatchMessage: msg wParam: wp lParam: lp to: aView [
        | sel |
        aView isNil ifTrue: [ ^nil ].
        sel := self selectorForMessage: msg.
        sel isNil ifTrue: [
            (aView respondsTo: #onMessage:wParam:lParam:) ifFalse: [ ^nil ].
            ^[ aView onMessage: msg wParam: wp lParam: lp ]
                on: Error
                do: [ :e | self noteHandlerError: e. nil ] ].
        (aView respondsTo: sel) ifFalse: [ ^nil ].
        ^[ aView perform: sel with: msg with: wp with: lp ]
            on: Error
            do: [ :e | self noteHandlerError: e. nil ]
    ]

    "The map is a 1024-slot Array indexed by (message number + 1) — Dolphin's
     own layout, so a translated `buildMessageMap` drops straight in."
    UiSession class >> selectorForMessage: msg [
        MessageMap isNil ifTrue: [ ^nil ].
        (msg < 0 or: [ msg + 1 > MessageMap size ]) ifTrue: [ ^nil ].
        ^MessageMap at: msg + 1
    ]
    UiSession class >> messageMap [ ^MessageMap ]

    "── the routed set ──────────────────────────────────────────────────
     Which messages the door reflects at all. The storm probe measured a
     routed message at ~26 microseconds, so the message COUNT is the only
     lever — and Dolphin hands us the minimal count for free, because
     `buildMessageMap` is an explicit list of exactly what the class handles.

     `routeMessages:` answers how many ids the door ACCEPTED. Compare it
     against what you sent: a half-installed map looks exactly like handlers
     that never fire."
    UiSession class >> routeMessages: aCollection [
        ^Win32 mvpSetRoutedMessages: aCollection asArray
    ]
    UiSession class >> routedMessageCount [ ^Win32 mvpRoutedMessageCount ]

    "Install a class's Dolphin message map AND the routed set it implies, in
     one step — they must agree. A routed message with no map entry falls
     through to DefWindowProcW (harmless but pointless); a map entry whose
     message is not routed never arrives at all, which is the silent half of
     the pair and the reason these are set together."
    UiSession class >> routeMessagesFrom: aBehavior [
        | map ids |
        map := aBehavior buildMessageMap.
        ids := OrderedCollection new.
        1 to: map size do: [ :i |
            (map at: i) isNil ifFalse: [ ids add: i - 1 ] ].
        MessageMap := map.
        ^self routeMessages: ids
    ]
    UiSession class >> clearMessageMap [
        MessageMap := nil.
        ^self routeMessages: (Array new: 0)
    ]

    "Route to a NAMED view, protecting the send HERE — inside the entry —
     because the door contains raises rather than propagating them outward."
    UiSession class >> send: aSelector to: aView arg: arg [
        aView isNil ifTrue: [ ^0 ].
        (aView respondsTo: aSelector) ifFalse: [ ^0 ].
        ^[ aView perform: aSelector with: arg ]
            on: Error
            do: [ :e | self noteHandlerError: e. 0 ]
    ]

    "The old spelling, still used by anything that means `the current view`."
    UiSession class >> dispatch: aSelector arg: arg [
        ^self send: aSelector to: LastWindow arg: arg
    ]

    UiSession class >> noteHandlerError: anException [
        Transcript showCr: 'UiSession: handler error — ', anException messageText.
        ^nil
    ]

    UiSession class >> messageCount [ ^MessageCount ifNil: [ 0 ] ]

    "── deferred actions ────────────────────────────────────────────────
     `postAction:` queues work to run on the UI thread OUTSIDE the current
     entry. Dolphin's own reason applies here too: a handler that rebuilds the
     window it is being called from must not do so mid-message. Drained by the
     pump, never inside a dispatch."
    UiSession class >> postAction: aBlock [ self actions add: aBlock. ^aBlock ]
    UiSession class >> pendingActions [ ^self actions size ]

    UiSession class >> drainActions [
        | queued n |
        "Drain a SNAPSHOT: an action that posts another action must not extend
         this drain into an unbounded loop."
        queued := self actions.
        n := queued size.
        Actions := OrderedCollection new.
        1 to: n do: [ :i |
            [ (queued at: i) value ]
                on: Error
                do: [ :e | self noteHandlerError: e ] ].
        ^n
    ]

    "── the pump ────────────────────────────────────────────────────────"
    UiSession class >> pump [
        | n |
        n := Win32 mvpPump: 200.
        self drainActions.
        n = 0 ifTrue: [ self onIdle ].
        ^n
    ]

    "Pump-empty hook. Dolphin revalidates command enablement here; v1 counts
     visits so a test can prove the hook fires at all."
    UiSession class >> onIdle [
        IdleCount := (IdleCount ifNil: [ 0 ]) + 1.
        LastWindow isNil ifFalse: [
            (LastWindow respondsTo: #onIdle) ifTrue: [ LastWindow onIdle ] ].
        ^IdleCount
    ]
    UiSession class >> idleCount [ ^IdleCount ifNil: [ 0 ] ]

    "── startup / shutdown ──────────────────────────────────────────────
     `startUp` re-runs after a generation bump: the HWNDs of the previous
     generation are stale and stop reaching the image (win_mvp.cpp), so the
     registry must be emptied rather than left holding dead handles."
    UiSession class >> startUp [
        Win32 mvpInstall.
        self reset.
        ^self
    ]
    UiSession class >> shutDown [
        self windows keysDo: [ :h | Win32 mvpDestroyWindow: h ].
        self reset.
        ^self
    ]
]

"The minimal view a session can route to. DD9 replaces this with the translated
 `UI.View`; it exists now so UiSession's routing has a real receiver and the DD7
 door tortures can be re-run through the session."
Object subclass: UiWindow [
    | hwnd painted commands destroys idles |
    UiWindow class >> open: width by: height [
        | w h |
        w := self basicNew initWindow.
        h := Win32 mvpCreateTopWindow: width height: height.
        w setHwnd: h.
        UiSession register: w for: h.
        ^w
    ]
    initWindow [ painted := 0. commands := 0. destroys := 0. idles := 0 ]
    setHwnd: h [ hwnd := h ]
    hwnd [ ^hwnd ]
    painted [ ^painted ]
    commands [ ^commands ]
    destroys [ ^destroys ]
    idles [ ^idles ]

    show [ ^Win32 mvpShow: hwnd ]
    invalidate [ ^Win32 mvpInvalidate: hwnd ]
    addButton: anId [ ^Win32 mvpCreateButton: hwnd id: anId ]
    click: anId [ ^Win32 mvpClick: hwnd id: anId ]
    close [ UiSession deregister: hwnd. ^Win32 mvpDestroyWindow: hwnd ]

    onPaint: hdc [ painted := painted + 1. ^0 ]
    onCommand: controlId [ commands := commands + 1. ^0 ]
    onDestroy: ignored [ destroys := destroys + 1. ^0 ]
    onIdle [ idles := idles + 1. ^idles ]
]
