"Pen is a <GraphicsTool> that wraps a Windows GDI Pen object. Pens are selected into <Canvas>s to draw lines in various styles, widths, and colours.

Instance Variables:
	logPen	<LOGPEN>. Logical description of the pen."

AbstractPen subclass: Pen [
    color: aColor [
        	self color = aColor ifTrue: [^self].
        	logPen lopnColor: (aColor ifNil: [ Color classVarBlack ]) .
        	self free
    ]
    createHandle [
        "Private - Answer an <ExternalHandle> to a new pen as described by the receiver's
        	<LOGPEN> structure."
        ^Gdi32 createPenIndirect: logPen
    ]
    logPen: aLOGPEN [
        "Private - Set the receiver's logical attributes."
        logPen := aLOGPEN.
        	self free
    ]
    printOn: aPuttableStream [
        "Append, to the <puttableStream> argument a string whose characters are a the same as those which would result from sending a #printString message to the receiver."
        | styleName width color | 
        	width := self width.
        	styleName := self styleName.
        	color := self color.
        	(width == 1 and: [color = Color classVarBlack])
        		ifTrue: 
        			[aPuttableStream
        				print: self class;
        				space;
        				nextPutAll: self styleName.
        			^self].aPuttableStream nextPut: $(. aPuttableStream print: self class.
        	styleName = 'solid'
        		ifFalse: 
        			[aPuttableStream
        				nextPutAll: ' styleName: #';
        				display: styleName].
        	width = 1
        		ifFalse: 
        			[aPuttableStream
        				nextPutAll: ' width: ';
        				print: width].
        	color = Color classVarBlack
        		ifFalse: 
        			[aPuttableStream
        				nextPutAll: ' color: ';
        				print: color].
        	aPuttableStream nextPut: $)
    ]
    style: flags [
        	self style = flags ifTrue: [^self].
        	logPen lopnStyle: flags.
        	self free
    ]
    styleName: aSymbol [
        "Set the style of the receiver to that named. Note that dotted/dashed styles 
        	are only supported if the pen is one pixel wide."
        self style: (self class styleNamed: aSymbol)
    ]
    width: anInteger [
        "Set the <integer> width (in pixels) of the line drawn by the receiver.
        	Note that if the width is greater than 1, then the pen style is ignored
        	and the pen will always be solid."
        self width = anInteger ifTrue: [^self].
        	logPen width: anInteger.
        	self free
    ]
    Pen class >> blue [
        "Answer a blue pen."
        ^self color: Color blue
    ]
    Pen class >> color: aColor [
        "Answer a new instance of the receiver for painting solid 1-pixel lines in the specified <Color>."
        ^aColor pen
    ]
    Pen class >> dashDot [
        	^self style: 3
    ]
    Pen class >> dashDotDot [
        	^self style: 4
    ]
    Pen class >> dashed [
        	^self style: 1
    ]
    Pen class >> dotted [
        	^self style: 2
    ]
    Pen class >> fromLogPen: aLOGPEN [
        "Answer a new instance of the receiver containing the given logical pen."
        | _casc1 | _casc1 := self new. _casc1 logPen: aLOGPEN. ^_casc1 yourself
    ]
    Pen class >> green [
        "Answer a green pen."
        ^self color: Color green
    ]
    Pen class >> insideFrame [
        	^self style: 6
    ]
    Pen class >> newColor: aColor [
        "Private - Answer a new instance of the receiver for painting 1-pixel wide lines in the specified solid colour."
        ^self 
        		style: 0
        		width: 0
        		color: aColor
    ]
    Pen class >> none [
        "Answer a null <Pen>"
        ^self
        		style: 5
        		width: 0
        		color: Color classVarNone
    ]
    Pen class >> red [
        "Answer a red pen."
        ^self color: Color red
    ]
    Pen class >> solid [
        	^self width: 1
    ]
    Pen class >> style: styleFlags [
        "Answer a new black 1-pixel pen of the specified style."
        ^self
        		style: styleFlags
        		width: 0
        		color: Color classVarBlack
    ]
    Pen class >> style: anInteger color: aColour [
        "Answer a new 1-pixel wide pen with the specified style and colour attributes."
        ^self
        		style: anInteger
        		width: 0
        		color: aColour
    ]
    Pen class >> style: styleInteger width: widthInteger [
        "Answer a new black pen with the the specified style and width."
        ^self
        		style: styleInteger
        		width: widthInteger
        		color: Color classVarBlack
    ]
    Pen class >> style: styleInteger width: widthInteger color: aColour [
        "Answer a new pen with the specified style, width and colour attributes."
        ^self fromLogPen: (LOGPEN newBuffer
        				lopnStyle: styleInteger;
        				width: widthInteger;
        				lopnColor: aColour;
        				yourself)
    ]
    Pen class >> styleName: aString [
        "Answer a new 1-pixedl black pen of the named style."
        ^self
        		styleName: aString
        		width: 0
        		color: Color black
    ]
    Pen class >> styleName: aSymbol color: aColor [
        "Answer a new 1-pixel wide pen of the named style, and specified colour."
        ^self
        		styleName: aSymbol
        		width: 0
        		color: aColor
    ]
    Pen class >> styleName: aSymbol width: anInteger [
        "Answer a new black pen with the of the named style and specified width."
        ^self
        		styleName: aSymbol
        		width: anInteger
        		color: Color classVarBlack
    ]
    Pen class >> styleName: aSymbol width: anInteger color: aColour [
        "Answer a new pen of the named style with the specified width and colour."
        ^self fromLogPen: (LOGPEN newBuffer
        				lopnStyle: (self styleNamed: aSymbol);
        				width: anInteger;
        				lopnColor: aColour;
        				yourself)
    ]
    Pen class >> styleNamed: aString [
        	| style |
        	style := (self styleNames indexOf: aString) - 1.
        	style < 0 ifTrue: [self error: 'Unrecognised Pen style <1p>'  << aString].
        	^style
    ]
    Pen class >> width: anInteger [
        "Answer a new solid black pen of the specified width."
        ^self
        		style: 0
        		width: anInteger
        		color: Color classVarBlack
    ]
    Pen class >> width: anInteger color: aColor [
        "Answer a new solid pen of the specified width and Color."
        ^self
        		style: 0
        		width: anInteger
        		color: aColor
    ]
    Pen class >> withStyle: styleFlags width: anInteger color: aColor [
        	#deprecated.
        	^self
        		style: styleFlags
        		width: anInteger
        		color: aColor
    ]
    Pen class >> withStyleName: aString [
        	#deprecated.
        	^self
        		styleName: aString
        		width: 0
        		color: Color black
    ]
]
