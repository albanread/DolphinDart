"MouseWheelEvent represents the subclass of events generated by mouse hardware input devices for scrolling of the wheel (where present), including horizontal scrolling (where supported by the device)."

MouseEvent subclass: MouseWheelEvent [
    isVertical [
        "Answer whether the receiver represents a vertical mouse wheel event (as opposed to a horizontal wheeling)."
        ^message == 522
    ]
    wheelRotation [
        "Answer the <number> of notches that the mouse wheel was rotated to generate this event."
        ^wParam highPartSigned / 120
    ]
]
